{
  "name": "do-it",
  "version": "0.1.0",
  "type": "module",
  "description": "An MCP server for controlling Claude Code sessions on your own machine from a remote Claude.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dlybeck/Do-It.git"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "do-it": "bin/do-it.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "deploy/",
    "examples/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/do-it.mjs start",
    "setup": "node bin/do-it.mjs setup",
    "test": "node --test --test-timeout=15000 test/*.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.316",
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0"
  }
}
